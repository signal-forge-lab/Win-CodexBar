{
  "manifest_version": 3,
  "name": "CodexBar Gemini Apps Bridge PoC",
  "version": "0.1.0",
  "description": "PoC: sends only Gemini Apps usage percentages and reset times to a local CodexBar native host.",
  "permissions": ["alarms", "idle", "storage", "nativeMessaging"],
  "host_permissions": ["https://gemini.google.com/*"],
  "action": {
    "default_title": "Connect CodexBar Gemini Apps PoC"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["gemini-interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["gemini-parser.js", "gemini-content.js"],
      "run_at": "document_idle"
    }
  ]
}
