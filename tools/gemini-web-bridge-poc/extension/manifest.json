{
  "manifest_version": 3,
  "name": "CodexBar Gemini Apps Bridge",
  "version": "0.2.5",
  "description": "Sends sanitized Gemini Apps quota and Gemini API spend summaries to the local CodexBar native host.",
  "permissions": ["alarms", "idle", "storage", "nativeMessaging", "scripting"],
  "host_permissions": ["https://gemini.google.com/*", "https://aistudio.google.com/spend*"],
  "action": {
    "default_title": "Connect CodexBar Gemini Apps"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["gemini-interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["gemini-parser.js", "gemini-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://aistudio.google.com/spend*"],
      "js": ["aistudio-parser.js", "aistudio-content.js"],
      "run_at": "document_idle"
    }
  ]
}
